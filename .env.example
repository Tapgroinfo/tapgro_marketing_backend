NODE_ENV=development
HTTP_PORT=3000
# Public URL of this API, used to build links for locally stored uploads
APP_BASE_URL=http://localhost:3000
# Set when behind nginx / a load balancer (e.g. 1) so rate limits and login history see the real client IP
TRUST_PROXY=

DB_URL=mongodb://localhost:27017/tapgro_marketing

# Admin panel JWT
ADMIN_JWT_KEY=
ADMIN_JWT_REFRESH_KEY=
ADMIN_JWT_EXPIRES_IN=3h
ADMIN_JWT_REFRESH_EXPIRES_IN=7d

# Created by `npm run seed`
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# File uploads go to S3 when AWS_BUCKET + AWS_REGION are set, otherwise ./uploads
# Keys are optional when running with an IAM role
AWS_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

SWAGGER_USER=admin
SWAGGER_PASSWORD=admin

LOG_LEVEL=log
# Structured JSON logs (Pino). Leave LOG_FILE empty for pretty console logs in dev.
LOG_FILE=
LOG_PRETTY=true
LOG_SERVICE_NAME=tapgro-marketing-backend
HTTP_LOG_ENABLED=true
# Warn when request exceeds this many ms
HTTP_LOG_SLOW_MS=2000
HTTP_LOG_SKIP_PATHS=/health

# SMTP, SMS, WhatsApp and Zernio/Ayrshare credentials are managed in the panel: PUT /api/backend/v1/settings
